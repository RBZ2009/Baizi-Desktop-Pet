{
  "name": "desktop-pet",
  "version": "1.0.0",
  "description": "白子桌宠：本地对话 gateway、自动上下文和长期记忆",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:silent": "electron . --disable-logging",
    "pack:mac": "electron-builder --mac dir",
    "dist:mac": "electron-builder --mac",
    "test": "node --test tests/*.test.js",
    "test:electron": "electron tests/electron-smoke.cjs"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.2",
    "@pixiv/three-vrm-animation": "^3.5.0",
    "sql.js": "^1.14.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.desktoppet.baizi",
    "productName": "白子桌宠",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "chat.html",
      "chat-renderer.js",
      "gateway-manager.js",
      "speech-service.js",
      "gateway/**/*",
      "ui/**/*",
      "assets/**/*",
      "vendor/three/**/*",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "identity": null,
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "assets/icon-mac.png"
    },
    "directories": {
      "output": "dist"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
